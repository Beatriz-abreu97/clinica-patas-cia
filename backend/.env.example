# Copie este arquivo para backend/.env e preencha os valores.
# O .env nunca vai para o Git (já está no .gitignore).

NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string → Session Pooler
# Use o Session Pooler (IPv4). A conexão direta do plano gratuito é IPv6 e
# não funciona no Render.
DATABASE_URL=postgresql://postgres.SEUREF:SUA_SENHA@aws-0-SAOREGIAO.pooler.supabase.com:5432/postgres

# Origens autorizadas no CORS, separadas por vírgula e sem barra no final.
CORS_ORIGINS=http://localhost:5173,https://clinica-patas-cia.vercel.app
